# Projetos são repositórios git próprios — a raiz versiona só o sistema.
# Âncora `/` para pegar SÓ o projetos/ da raiz (não pastas `projetos` aninhadas no
# código do painel, ex.: painel/servidor/src/projetos/).
/projetos/

# Aprovações locais de permissão (pessoais, não versionar)
.claude/settings.local.json

# Lixo de SO
Thumbs.db
desktop.ini
.DS_Store

# Documentos do TCC: figuras e PDFs de conferência são gerados pelos scripts
_sistema/documentos-tcc/geradores/figs3/
_sistema/documentos-tcc/geradores/figs_en/
_sistema/documentos-tcc/geradores/__pycache__/
_sistema/documentos-tcc/geradores/*.pdf
_sistema/documentos-tcc/geradores/v*-pg*.png

# Concatenacoes montadas pelos gerar*.py a cada execucao
_sistema/documentos-tcc/geradores/documento6.py
_sistema/documentos-tcc/geradores/documento6_en.py
_sistema/documentos-tcc/geradores/documento7.py
_sistema/documentos-tcc/geradores/documento7_en.py
